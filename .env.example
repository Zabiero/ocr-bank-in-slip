# Anthropic API key used to read the slip image and extract structured fields.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Path to a Google service account JSON key with access to the Sheets API.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The spreadsheet to append rows to (the long id in the sheet's URL) and the
# worksheet/tab name. The tab is created automatically if it doesn't exist.
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_WORKSHEET=Slips
