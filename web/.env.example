# Copy this file to .env.local (gitignored) for local dev, and add the same
# two values as GitHub repo secrets (Settings -> Secrets and variables ->
# Actions) for the deployed site. Both optional - without them the app works
# exactly as before, just without the central record-keeping feature.
# See README.md "Central record-keeping" for full setup steps.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
